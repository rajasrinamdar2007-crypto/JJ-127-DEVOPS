POSTGRES_USER=anpruser
POSTGRES_PASSWORD=REDACTED
POSTGRES_DB=anpr

# Host-side port bindings (the containers always listen on 1883 / 8000 / 8000 / 80 internally).
# Change these if something else already holds them on your machine.
MQTT_HOST_PORT=1883
INGEST_HOST_PORT=8000
GIS_HOST_PORT=8001

# The dashboard. This is the port you open in a browser; nginx listens on 80 inside the
# container. The API is reachable both directly on GIS_HOST_PORT and through this port
# under /api/, so http://localhost:8080/api/sightings/geojson and
# http://localhost:8001/sightings/geojson return the same thing.
FRONTEND_HOST_PORT=8080

# Mosquitto credentials. The ACL in mosquitto/config/acl.txt grants each camera
# user write access to exactly one topic (anpr/<camera_id>/sightings), and the
# ingest user read access to anpr/+/sightings.
#
# The broker's password file is GENERATED from these values by `make passwd` and
# is gitignored. If you change anything here, re-run `make passwd` before `make up`,
# otherwise mosquitto will refuse to start (no user will match the file).
MQTT_SERVER_USER=server
MQTT_SERVER_PASSWORD=REDACTED
MQTT_INGEST_USER=ingest
MQTT_INGEST_PASSWORD=REDACTED

# Read-only account for `make debug-subscribe` (server/subscriber.py). Separate from the
# ingest account on purpose: same read scope, but its own identity in the broker's access
# log, so you can tell the debug tool apart from the real subscriber.
MQTT_DEBUG_USER=debug
MQTT_DEBUG_PASSWORD=REDACTED

# Simulated cameras. One edge-agent container per camera, so these are consumed twice:
# by docker-compose.yml (CAM*_ID/_LAT/_LON/_PASS) and by `make passwd` (the credentials).
#
# CAM*_ID MUST equal the camera's MQTT username, and acl.txt MUST have a matching
# `user` block with `topic write anpr/<CAM*_ID>/sightings`. Adding a camera means:
#   1. add CAM4_* here (including _NAME and _ZONE)
#   2. add the user block to mosquitto/config/acl.txt
#   3. add the user to MQTT_USERS in the Makefile
#   4. copy an edge-agent-* block in docker-compose.yml
#   5. make passwd
#
# Lat/lon are the camera's surveyed position. CAM*_JITTER_M is survey noise only -
# keep it small, these are cameras on poles, not vehicles.
CAM1_ID=cam-pune-hinjewadi-01
CAM1_NAME=Hinjewadi Entry
CAM1_ZONE=West
CAM1_PASS=REDACTED
CAM1_LAT=18.5913
CAM1_LON=73.7389
CAM1_JITTER_M=2

CAM2_ID=cam-pune-baner-02
CAM2_NAME=Baner Junction
CAM2_ZONE=West
CAM2_PASS=REDACTED
CAM2_LAT=18.5295
CAM2_LON=73.7868
CAM2_JITTER_M=2

CAM3_ID=cam-pune-kothrud-03
CAM3_NAME=Kothrud Depot
CAM3_ZONE=West
CAM3_PASS=REDACTED
CAM3_LAT=18.5074
CAM3_LON=73.8077
CAM3_JITTER_M=2
